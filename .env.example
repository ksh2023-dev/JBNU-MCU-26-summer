# 이 파일을 복사해 .env 로 저장하고 값을 채우세요. (.env는 .gitignore에 등록되어 커밋되지 않습니다)
# OPENALEX_API_KEY: OpenAlex 무료 계정의 API 키 — openalex.org 가입 후 설정(Settings)에서 복사
#   (2026-02-13부터 OpenAlex가 mailto/polite pool 방식을 폐지하고 모든 호출에 api_key를 요구합니다)
OPENALEX_API_KEY=your-api-key-here
# KCI_API_KEY: KCI(한국학술지인용색인) Open API 인증키 — open.kci.go.kr에서 신청·승인 후 발급
#   (인증키는 신청 시 등록한 서비스 IP에서만 동작합니다 — 계약 v6.4 7장의 고정 IP 수집 서버)
KCI_API_KEY=your-key-here
